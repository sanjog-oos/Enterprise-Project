package-lock.json
yarn.lock

# -- Environment variables (NEVER commit) ------
.env
.env.local
.env.development
.env.production
.env.test
server/.env

# -- Logs --------------------------------------
logs/
*.log
server/logs/

# -- MongoDB local data ------------------------
data/
db/
*.db

# -- OS generated files ------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -- VS Code -----------------------------------
.vscode/
*.code-workspace

# -- JetBrains IDEs ----------------------------
.idea/
*.iml
*.iws

# -- Build output ------------------------------
dist/
build/
out/

# -- Cache files -------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# -- Testing -----------------------------------
coverage/
.nyc_output/

# -- Temp / scratch ----------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
tmp/
temp/

# -- Archives ----------------------------------
*.zip
*.tar.gz
*.rar
*.7z

# -- Windows shortcuts -------------------------
*.lnk

# -- Secrets / certificates --------------------
*.pem
*.key
*.cert
*.p12
secrets.json
config/secrets.*

# -- Old backup files in project ---------------
index/index1.html

